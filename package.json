{
  "name": "annapurna-order-agent",
  "version": "0.1.0",
  "description": "Customer web ordering app for Annapurna Authentic Home Foods. Code owns control flow, TypeSafe judges intent, Claude words the replies.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node --disable-warning=ExperimentalWarning dist/src/index.js",
    "test": "tsc && node --disable-warning=ExperimentalWarning --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
