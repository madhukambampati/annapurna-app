# Copy to .env and fill in. Run with:
#   node --env-file=.env --disable-warning=ExperimentalWarning dist/src/index.js
PORT=3000
DB_PATH=annapurna.db

# Claude writes the replies. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# TypeSafe judges intent / cancel / yes. Without a key the built-in rules are used instead.
TYPESAFE_API_KEY=

# REQUIRED. Protects your order desk at /desk. At least 16 characters, random:  openssl rand -hex 24
# The server refuses to start without it (for local testing only: ALLOW_OPEN_DESK=yes).
OWNER_TOKEN=

# Push alerts to your phone: install the ntfy app, pick a secret topic name, then:
# NOTIFY_URL=https://ntfy.sh/annapurna-your-secret-topic
NOTIFY_URL=

# How many reverse proxies sit in front of the app. Usually 1; on Fly.io start with 2. Check it in the desk, Rules tab.
# Wrong value = rate limits see the proxy's IP instead of each customer's. 0 = direct connection.
PROXY_HOPS=0

# Customer website at "/". Set WEB=off to turn it off.
# WEB=off

# Abuse and cost limits (defaults shown)
# WEB_SESSIONS_PER_IP_HOUR=6    new chats one IP can start per hour
# WEB_MSG_PER_MINUTE=12         messages per customer per minute
# WEB_MSG_PER_DAY=80            messages per customer per day
# WEB_GLOBAL_PER_DAY=1500       messages from everyone per day. Hard stop on your Claude bill.
# WEB_SESSION_DAYS=60           a customer stays logged in this long without use

# Developer chat at /sim/*, no login. Leave off on a public server.
# SIMULATOR=on

# Routing thresholds (see README). Defaults are a starting point, tune them on real messages.
# TH_INTENT_PROB=0.6
# TH_CANCEL=0.6
# TH_CANCEL_MAYBE=0.3
# TH_CONFIRM=0.9
# TH_CONFIRM_MAYBE=0.5
# TH_UNCLEAR_STREAK=2
